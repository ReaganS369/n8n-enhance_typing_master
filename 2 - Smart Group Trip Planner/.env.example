# ===================================================================
# TripSync Environment Configuration — Template
# Copy this file to .env and fill in real values locally (never commit .env)
# ===================================================================

# Public Application URL
VITE_APP_NAME="TripSync"
VITE_APP_TAGLINE="Smart Group Trip Planner"

# Open-Meteo Weather API (No key required for standard rate-limited tier)
# Custom API endpoint override if using private commercial tier
VITE_OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# Geocoding API endpoint
VITE_GEOCODING_API_BASE_URL="https://geocoding-api.open-meteo.com/v1"

# Mapbox / Unsplash / Google Places API Key placeholders (optional integrations)
VITE_MAP_API_KEY=""
VITE_PLACES_API_KEY=""
VITE_UNSPLASH_ACCESS_KEY=""

# Feature Flags
VITE_ENABLE_LIVE_WEATHER=true
VITE_DEBUG_SCORING=false
